# Automated VAPT & Security Assessment Framework — environment template
# Copy this file to .env and adjust locally. Do not commit real secrets.

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
VAPT_LOG_LEVEL=INFO

# MySQL persistence (Phase 7). Disabled by default so scans work without a database.
VAPT_DATABASE_ENABLED=false
VAPT_DB_HOST=localhost
VAPT_DB_PORT=3306
VAPT_DB_NAME=vapt_framework
VAPT_DB_USER=vapt_user
VAPT_DB_PASSWORD=change_me

# Legacy placeholder URL (unused by the connector; do not put real secrets here)
VAPT_DATABASE_URL=mysql://user:password@localhost:3306/vapt

# HTTP client settings (used in later phases; parsed now)
VAPT_REQUEST_TIMEOUT=10
VAPT_HTTP_TIMEOUT=10
VAPT_USER_AGENT=VAPT-Framework/0.1 (+authorized-assessment)

# TLS verification (set false only for authorized labs with self-signed certs)
VAPT_TLS_VERIFY=true

# Same-origin crawler limits
VAPT_MAX_PAGES=50
VAPT_MAX_DEPTH=3
VAPT_MAX_REDIRECTS=5

# Active scanners (Phase 5). Detection GETs only; no exploitation.
# Default is enabled because `scan` already requires an authorized target.
VAPT_ENABLE_ACTIVE_SCANNERS=true
VAPT_MAX_SCANNER_REQUESTS=25

# Nmap service discovery timeout in seconds (Phase 2)
VAPT_NMAP_TIMEOUT=120

# Output locations
VAPT_REPORT_DIR=reports
VAPT_SCAN_OUTPUT_DIR=data/scans
